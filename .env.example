# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_BASE=https://api.deepseek.com

# Web 设置页也可切换任意 OpenAI-compatible API；留空时回退到上面的 DeepSeek 配置。
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_API_BASE=

# Embedding 模型: bge-small-zh(推荐,免费), bge-m3(多语言), bge-base-zh, openai(需API key)
EMBEDDING_MODEL=bge-small-zh

# HuggingFace 端点 (默认 huggingface.co; 国内网络可用代理时保持默认)
HF_ENDPOINT=https://huggingface.co

# 数据目录（默认: <KNOWLEDGE_HOME>/data/docs，自动创建）
DATA_DIR=./data/docs

# ChromaDB 持久化目录（Windows 路径含中文时设为 ASCII 绝对路径）
CHROMA_PERSIST_DIR=./chroma_db

# 会话历史与文件追踪（默认锚定 KNOWLEDGE_HOME，可用环境变量覆盖）
CHAT_HISTORY_DIR=
FILE_TRACKER_PATH=

# 分块参数
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# 检索参数
TOP_K=5

# LLM 模型名
LLM_MODEL=deepseek-chat

# 功能开关
ENABLE_HYBRID_SEARCH=true    # 混合检索（向量 + BM25）；影响聊天来源的候选检索链路
ENABLE_GRAPH=true            # 知识图谱检索；影响聊天来源的候选检索链路
ENABLE_GRAPH_LLM_EXTRACTION=false  # 用 LLM 做图谱实体关系抽取（消耗 DeepSeek API）
GRAPH_LLM_BATCH_SIZE=10       # 每批送入 LLM 的 chunk 数
GRAPH_LLM_CONCURRENCY=5       # LLM 图谱抽取并发批数（并行调用 DeepSeek，提速明显）

# 定时同步的经验库目录（分号分隔的服务器本机绝对路径；留空则不启用）。
# 由 sync_experience 原位读取，不做整树复制，仅索引新增/变更的 md/txt/pdf。
EXPERIENCE_DIRS=
SYNC_INTERVAL_HOURS=24        # 自动同步间隔（小时），可在 Web 知识库页触发"立即同步"

# 会话历史上下文管理：超过轮数/估算 token 后，把较早历史压缩成摘要发给 Agent（完整历史仍保存）。
HISTORY_COMPRESS_ROUNDS=10
HISTORY_MAX_TOKENS=4000
# Agent graph checkpoint database (relative paths anchor to KNOWLEDGE_HOME)
CHECKPOINT_DB_PATH=./data/agent_checkpoints.sqlite

# 局域网访问保护
# 设置后，非本机客户端访问 API/MCP 需 `Authorization: Bearer <LAN_TOKEN>`；
# 本机回环访问始终免登录。留空则无保护（仅限本机使用）。
# 简单访问令牌（明文传输，属便利性屏障而非强认证）。
# 局域网访问时用 `knowledge web --host 0.0.0.0` 启动。
LAN_TOKEN=

# 飞书机器人（可选，接入知识库到飞书时配置）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_MAX_CONCURRENCY=10
FEISHU_QUEUE_SIZE=50
FEISHU_DEDUPE_TTL=600
# 知识库 API 地址（飞书机器人进程调用）
KB_API_BASE=http://127.0.0.1:8000

# 启动优化：HTTP 服务先启动，embedding/Chroma/BM25 在后台预热；
# 预热完成前，依赖知识库的接口返回 503。默认 false，稳定部署可保持默认。
FAST_STARTUP=false
