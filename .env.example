# DeepSeek API
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_API_BASE=https://api.deepseek.com

# Embedding 模型: bge-small-zh(推荐,免费), bge-m3(多语言), bge-base-zh, openai(需API key)
EMBEDDING_MODEL=bge-small-zh

# HuggingFace 端点 (默认 huggingface.co; 国内网络可用代理时保持默认)
HF_ENDPOINT=https://huggingface.co

# 数据目录（默认: <KNOWLEDGE_HOME>/data/docs，自动创建）
DATA_DIR=./data/docs

# ChromaDB 持久化目录（Windows 路径含中文时设为 ASCII 绝对路径）
CHROMA_PERSIST_DIR=./chroma_db

# 会话历史与文件追踪（默认锚定 KNOWLEDGE_HOME，可用环境变量覆盖）
CHAT_HISTORY_DIR=
FILE_TRACKER_PATH=

# 分块参数
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# 检索参数
TOP_K=5

# LLM 模型名
LLM_MODEL=deepseek-chat
